{
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "JSON schema reference for configuration validation"
    },
    "shell": {
      "type": "string",
      "description": "Default shell to use for terminal and shell tool execution"
    },
    "model": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[^/#]+\\/[^#]+(?:#[^#]+)?$"
        },
        {
          "type": "object",
          "properties": {
            "providerID": {
              "type": "string",
              "pattern": "^[^/#]+$"
            },
            "model": {
              "type": "string",
              "pattern": "^[^#]+$"
            },
            "variant": {
              "type": "string",
              "pattern": "^[^#]+$"
            }
          },
          "required": [
            "providerID",
            "model"
          ],
          "additionalProperties": false
        }
      ],
      "description": "Default model to use when no session or agent model is selected"
    },
    "default_agent": {
      "type": "string",
      "description": "Default primary agent to use when no session agent is selected"
    },
    "update": {
      "type": "string",
      "enum": [
        "disable",
        "notify",
        "auto"
      ],
      "description": "Disable updates, notify when one is available, or install updates automatically"
    },
    "share": {
      "type": "string",
      "enum": [
        "manual",
        "auto",
        "disabled"
      ],
      "description": "Control whether sessions may be shared manually, automatically, or not at all"
    },
    "enterprise": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "description": "Enterprise URL"
        }
      },
      "additionalProperties": false,
      "description": "Enterprise sharing service configuration"
    },
    "username": {
      "type": "string",
      "description": "Username displayed in conversations and used for telemetry identity"
    },
    "permissions": {
      "$ref": "#/$defs/Permission.Ruleset",
      "description": "Ordered tool permission rules applied to agent tool use"
    },
    "policies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "provider.use",
              "tool.use",
              "integration.use"
            ]
          },
          "resource": {
            "type": "string"
          },
          "effect": {
            "type": "string",
            "enum": [
              "allow",
              "deny"
            ]
          }
        },
        "required": [
          "action",
          "resource",
          "effect"
        ],
        "additionalProperties": false
      },
      "description": "Ordered policies controlling access to providers, tools, and integrations"
    },
    "agents": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Config.AgentEncoded"
      },
      "description": "Named built-in agent overrides and custom agent definitions"
    },
    "snapshots": {
      "type": "boolean",
      "description": "Enable snapshots used for undo and revert behavior"
    },
    "watcher": {
      "type": "object",
      "properties": {
        "ignore": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "description": "Filesystem watcher configuration"
    },
    "formatter": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Config.Formatter.EntryEncoded"
          }
        }
      ],
      "description": "Enable built-in formatters or configure formatter overrides"
    },
    "lsp": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "disabled": {
                    "type": "boolean",
                    "enum": [
                      true
                    ]
                  }
                },
                "required": [
                  "disabled"
                ],
                "additionalProperties": false
              },
              {
                "$ref": "#/$defs/Config.LSP.ServerEncoded"
              }
            ]
          }
        }
      ],
      "description": "Enable built-in language servers or configure server overrides"
    },
    "media": {
      "type": "object",
      "properties": {
        "image": {
          "type": "object",
          "properties": {
            "auto_resize": {
              "type": "boolean"
            },
            "max_width": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "max_height": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "max_base64_bytes": {
              "type": "integer",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "description": "Media processing configuration"
    },
    "tool_output": {
      "type": "object",
      "properties": {
        "max_lines": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "Maximum lines of tool output before it is truncated and saved to disk (default: 2000)"
        },
        "max_bytes": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "description": "Maximum bytes of tool output before it is truncated and saved to disk (default: 51200)"
        }
      },
      "additionalProperties": false,
      "description": "Tool output truncation thresholds"
    },
    "mcp": {
      "type": "object",
      "properties": {
        "timeout": {
          "type": "object",
          "properties": {
            "startup": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "catalog": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "execution": {
              "type": "integer",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        },
        "servers": {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "$ref": "#/$defs/Mcp.LocalConfigEncoded"
              },
              {
                "$ref": "#/$defs/Mcp.RemoteConfigEncoded"
              }
            ]
          }
        }
      },
      "additionalProperties": false,
      "description": "MCP server configuration"
    },
    "compaction": {
      "type": "object",
      "properties": {
        "auto": {
          "type": "boolean",
          "description": "Enable automatic compaction when context is full (default: true)"
        },
        "keep": {
          "type": "object",
          "properties": {
            "tokens": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "buffer": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "description": "Conversation compaction behavior"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Additional paths or URLs to discover skills from"
    },
    "commands": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Config.CommandEncoded"
      },
      "description": "Named slash command definitions"
    },
    "instructions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Additional paths or URLs supplying ambient instructions"
    },
    "references": {
      "type": "object",
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "$ref": "#/$defs/Config.Reference.GitEncoded"
          },
          {
            "$ref": "#/$defs/Config.Reference.LocalEncoded"
          }
        ]
      },
      "description": "Named local directories or Git repositories available as external context"
    },
    "websearch": {
      "anyOf": [
        {
          "type": "boolean",
          "enum": [
            false
          ]
        },
        {
          "$ref": "#/$defs/ConfigWebSearch.InfoEncoded"
        }
      ],
      "description": "Web search provider selection"
    },
    "plugins": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "$ref": "#/$defs/Config.Plugin.EntryEncoded"
          }
        ]
      },
      "description": "Ordered plugin enablement directives and external package declarations"
    },
    "worktree": {
      "$ref": "#/$defs/Config.Worktree",
      "description": "Directory defaults for local worktree creation"
    },
    "warming": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/Config.WarmingEncoded"
        }
      ],
      "description": "Keep recently active sessions warm with transient model requests (default: false)"
    },
    "providers": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/Config.ProviderEncoded"
      }
    },
    "experimental": {
      "type": "object",
      "properties": {
        "portable_shell_scanner": {
          "type": "boolean"
        },
        "todo": {
          "type": "boolean"
        },
        "background_compaction": {
          "type": "boolean"
        },
        "subagent_depth": {
          "type": "integer",
          "minimum": 0
        },
        "location_idle_timeout": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "boolean",
              "enum": [
                false
              ]
            }
          ]
        },
        "policies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "action": {
                "type": "string",
                "enum": [
                  "provider.use",
                  "tool.use",
                  "integration.use"
                ]
              },
              "resource": {
                "type": "string"
              },
              "effect": {
                "type": "string",
                "enum": [
                  "allow",
                  "deny"
                ]
              }
            },
            "required": [
              "action",
              "resource",
              "effect"
            ],
            "additionalProperties": false
          },
          "description": "Policy statements applied to supported resources, such as provider access"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Permission.Effect": {
      "type": "string",
      "enum": [
        "allow",
        "deny",
        "ask"
      ]
    },
    "Permission.Rule": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string"
        },
        "resource": {
          "type": "string"
        },
        "effect": {
          "$ref": "#/$defs/Permission.Effect"
        }
      },
      "required": [
        "action",
        "resource",
        "effect"
      ],
      "additionalProperties": false
    },
    "Permission.Ruleset": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Permission.Rule"
      }
    },
    "Config.AgentEncoded": {
      "type": "object",
      "properties": {
        "model": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[^/#]+\\/[^#]+(?:#[^#]+)?$"
            },
            {
              "type": "object",
              "properties": {
                "providerID": {
                  "type": "string",
                  "pattern": "^[^/#]+$"
                },
                "model": {
                  "type": "string",
                  "pattern": "^[^#]+$"
                },
                "variant": {
                  "type": "string",
                  "pattern": "^[^#]+$"
                }
              },
              "required": [
                "providerID",
                "model"
              ],
              "additionalProperties": false
            }
          ]
        },
        "request": {
          "type": "object",
          "properties": {
            "headers": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "body": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "system": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": [
            "subagent",
            "primary",
            "all"
          ]
        },
        "hidden": {
          "type": "boolean"
        },
        "color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "steps": {
          "type": "integer",
          "exclusiveMinimum": 0
        },
        "disabled": {
          "type": "boolean"
        },
        "permissions": {
          "$ref": "#/$defs/Permission.Ruleset"
        }
      },
      "additionalProperties": false
    },
    "Config.Formatter.EntryEncoded": {
      "type": "object",
      "properties": {
        "disabled": {
          "type": "boolean"
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "Config.LSP.ServerEncoded": {
      "type": "object",
      "properties": {
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extensions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "disabled": {
          "type": "boolean"
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "initialization": {
          "type": "object"
        }
      },
      "required": [
        "command"
      ],
      "additionalProperties": false
    },
    "Mcp.Protocol": {
      "type": "string",
      "enum": [
        "legacy",
        "auto",
        "2026-07-28"
      ],
      "description": "MCP protocol negotiation. \"legacy\" (default) opens with the initialize handshake and speaks protocol revisions up to 2025-11-25. \"auto\" probes for the 2026-07-28 revision and falls back to legacy when the server does not support it. \"2026-07-28\" requires that revision and fails otherwise."
    },
    "Mcp.LocalConfigEncoded": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "local"
          ]
        },
        "command": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "cwd": {
          "type": "string"
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "disabled": {
          "type": "boolean"
        },
        "codemode": {
          "type": "boolean"
        },
        "timeout": {
          "type": "object",
          "properties": {
            "startup": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "catalog": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "execution": {
              "type": "integer",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        },
        "protocol": {
          "$ref": "#/$defs/Mcp.Protocol"
        }
      },
      "required": [
        "type",
        "command"
      ],
      "additionalProperties": false
    },
    "Mcp.OAuthConfigEncoded": {
      "type": "object",
      "properties": {
        "client_id": {
          "type": "string"
        },
        "client_secret": {
          "type": "string"
        },
        "scope": {
          "type": "string"
        },
        "callback_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "redirect_uri": {
          "type": "string"
        },
        "auth_server_metadata_url": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Mcp.RemoteConfigEncoded": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "remote"
          ]
        },
        "url": {
          "type": "string"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "oauth": {
          "anyOf": [
            {
              "$ref": "#/$defs/Mcp.OAuthConfigEncoded"
            },
            {
              "type": "boolean",
              "enum": [
                false
              ]
            }
          ]
        },
        "disabled": {
          "type": "boolean"
        },
        "codemode": {
          "type": "boolean"
        },
        "timeout": {
          "type": "object",
          "properties": {
            "startup": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "catalog": {
              "type": "integer",
              "exclusiveMinimum": 0
            },
            "execution": {
              "type": "integer",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": false
        },
        "protocol": {
          "$ref": "#/$defs/Mcp.Protocol"
        }
      },
      "required": [
        "type",
        "url"
      ],
      "additionalProperties": false
    },
    "Config.CommandEncoded": {
      "type": "object",
      "properties": {
        "template": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "agent": {
          "type": "string"
        },
        "model": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[^/#]+\\/[^#]+(?:#[^#]+)?$"
            },
            {
              "type": "object",
              "properties": {
                "providerID": {
                  "type": "string",
                  "pattern": "^[^/#]+$"
                },
                "model": {
                  "type": "string",
                  "pattern": "^[^#]+$"
                },
                "variant": {
                  "type": "string",
                  "pattern": "^[^#]+$"
                }
              },
              "required": [
                "providerID",
                "model"
              ],
              "additionalProperties": false
            }
          ]
        },
        "subagent": {
          "type": "boolean"
        },
        "subtask": {
          "type": "boolean",
          "description": "Deprecated alias for subagent."
        }
      },
      "required": [
        "template"
      ],
      "additionalProperties": false
    },
    "Config.Reference.GitEncoded": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "hidden": {
          "type": "boolean"
        }
      },
      "required": [
        "repository"
      ],
      "additionalProperties": false
    },
    "Config.Reference.LocalEncoded": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "hidden": {
          "type": "boolean"
        }
      },
      "required": [
        "path"
      ],
      "additionalProperties": false
    },
    "WebSearch.ID": {
      "type": "string"
    },
    "ConfigWebSearch.InfoEncoded": {
      "type": "object",
      "properties": {
        "provider": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "random"
              ],
              "description": "Reuse a randomly selected provider until it is rate limited, then switch to another available provider."
            },
            {
              "$ref": "#/$defs/WebSearch.ID"
            }
          ]
        }
      },
      "required": [
        "provider"
      ],
      "additionalProperties": false
    },
    "Config.Plugin.EntryEncoded": {
      "type": "object",
      "properties": {
        "package": {
          "type": "string"
        },
        "options": {
          "type": "object"
        }
      },
      "required": [
        "package"
      ],
      "additionalProperties": false
    },
    "Config.Worktree": {
      "type": "object",
      "properties": {
        "directory": {
          "type": "string"
        }
      },
      "required": [
        "directory"
      ],
      "additionalProperties": false
    },
    "Config.WarmingEncoded": {
      "type": "object",
      "properties": {
        "prompt": {
          "type": "string"
        },
        "interval": {
          "type": "string"
        },
        "duration": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Provider.ID": {
      "type": "string"
    },
    "Model.ReasoningField": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "reasoning",
            "reasoning_content",
            "reasoning_text"
          ]
        },
        {
          "type": "string"
        }
      ]
    },
    "Model.MaxTokensField": {
      "type": "string",
      "enum": [
        "max_completion_tokens",
        "max_tokens"
      ]
    },
    "Model.CacheFormat": {
      "type": "string",
      "enum": [
        "anthropic",
        "alibaba"
      ]
    },
    "Provider.Compatibility": {
      "type": "object",
      "properties": {
        "reasoningField": {
          "$ref": "#/$defs/Model.ReasoningField"
        },
        "requireReasoning": {
          "type": "boolean"
        },
        "maxTokensField": {
          "$ref": "#/$defs/Model.MaxTokensField"
        },
        "requireFinishReason": {
          "type": "boolean"
        },
        "requireAssistantAfterTool": {
          "type": "boolean"
        },
        "supportsPromptCacheKey": {
          "type": "boolean"
        },
        "streamUsage": {
          "type": "boolean"
        },
        "cacheFormat": {
          "$ref": "#/$defs/Model.CacheFormat"
        }
      },
      "additionalProperties": false
    },
    "Provider.Compaction": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "summary"
              ]
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "native"
              ]
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Provider.Transport": {
      "type": "string",
      "enum": [
        "http",
        "websocket"
      ]
    },
    "Provider.Encoding": {
      "type": "string",
      "enum": [
        "zstd",
        "gzip",
        "none"
      ]
    },
    "Config.Provider.Settings": {
      "type": "object",
      "properties": {
        "timeout": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "boolean",
              "enum": [
                false
              ]
            }
          ]
        },
        "headerTimeout": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "boolean",
              "enum": [
                false
              ]
            }
          ]
        },
        "chunkTimeout": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "boolean",
              "enum": [
                false
              ]
            }
          ]
        },
        "compaction": {
          "$ref": "#/$defs/Provider.Compaction"
        },
        "transport": {
          "$ref": "#/$defs/Provider.Transport"
        },
        "encoding": {
          "$ref": "#/$defs/Provider.Encoding"
        }
      },
      "allOf": [
        {
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {},
              {
                "type": "null"
